---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    Each lab pairs with that week's lecture and asks you to build or break a
    small piece of the system just described — a toy T9 disambiguator, an
    autocorrect you deliberately trip up, an audit of your own inbox's smart
    replies. Bring what the week's brief asks for; what you leave with is
    listed on each lab's own page.
  </p>
  <SessionsGrid />
</ContentLayout>
